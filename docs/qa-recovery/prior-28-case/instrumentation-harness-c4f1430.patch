+        EmulatorEvidence.text("blacklist-${testName.methodName}-requests.txt", "Production NativeApp with synthetic public repository and deny-all account transport.\nUser requests=$userRequests\nTopic requests=$topicRequests\nAccount calls=${calls.get()}")
+    }
+    private fun captureDialog(name: String) {
+        // Save original pixels before assertions so a rejected viewport is still reviewable.
+        capture(name)
+        val body = compose.onNodeWithTag("blacklist-clear-body", useUnmergedTree = true)
+        val viewport = compose.onNodeWithTag("blacklist-clear-viewport", useUnmergedTree = true)
+            .fetchSemanticsNode().boundsInWindow
+        val layouts = mutableListOf<TextLayoutResult>()
+        body.performSemanticsAction(SemanticsActions.GetTextLayoutResult) { it(layouts) }
+        val layout = layouts.single()
+        val origin = body.fetchSemanticsNode().positionInWindow
+        val phrase = if (name.endsWith("-tail")) "可先导出备份。" else "仅清空用户名单，无法撤销。"
+        val start = layout.layoutInput.text.text.indexOf(phrase)
+        assertTrue("Required destructive consequence/backup text must exist", start >= 0)
+        val boxes = (start until start + phrase.length).map { layout.getBoundingBox(it).translate(origin) }
+        val line = layout.getLineForOffset(start)
+        val lineHeight = layout.getLineBottom(line) - layout.getLineTop(line)
+        val evidence = buildJsonObject {
+            put("requiredPhrase", phrase); put("effectiveFontScale", layout.layoutInput.density.fontScale)
+            put("clippedViewport", viewport.toString()); put("textOriginInWindow", origin.toString())
+            put("renderedLineHeightPx", lineHeight)
+            put("glyphBoxesInWindow", JsonArray(boxes.map { JsonPrimitive(it.toString()) }))
+        }
+        EmulatorEvidence.text("blacklist-${testName.methodName}-$name-body-layout.json", evidence.toString())
+        assertEquals(2.4f, layout.layoutInput.density.fontScale, .01f)
+        assertTrue("Body viewport must fit a complete rendered line", viewport.height + 1f >= lineHeight)
+        boxes.forEach { box ->
