+#!/usr/bin/env bash
+set -euo pipefail
+final=${1:?final production commit}; apk=${2:?final production APK}; testapk=${3:?test APK}; out=${4:?evidence directory}
+cd "$(dirname "$0")/.."
+mkdir -p "$out"
+git diff --exit-code "$final" -- app/src/main buildSrc/src build.gradle.kts settings.gradle.kts gradle gradle.properties
+{
+ printf 'production_commit=%s\n' "$(git rev-parse "$final")"
+ printf 'production_tree=%s\n' "$(git rev-parse "$final^{tree}")"
+ printf 'harness_commit=%s\n' "$(git rev-parse HEAD)"
+ printf 'harness_tree=%s\n' "$(git rev-parse HEAD^{tree})"
+ printf 'No production sources/buildSrc/root toolchain differences against final commit.\n'
+ printf 'Only app build.gradle AndroidTest dependencies/test sources/qa are harness-specific.\n'
+ git status --short
+} > "$out/source-binding.txt"
+git diff "$final" -- app/build.gradle.kts > "$out/test-only-gradle-diff.patch"
+sha256sum "$apk" "$testapk" > "$out/apks.sha256"
+find app/src/main app/src/androidTest -type f -print0 | sort -z | xargs -0 sha256sum > "$out/source-and-harness-files.sha256"
+unzip -l "$apk" > "$out/production-apk-contents.txt"
+unzip -l "$testapk" > "$out/test-apk-contents.txt"
+if unzip -l "$apk" | grep -Eq '(androidTest|icon-grid/icon-[0-9]|EmulatorGraphicRetry|independent-emulator-qa)'; then
+ echo 'Unexpected instrumentation fixtures in production APK' >&2; exit 1
+fi
