+#!/usr/bin/env bash
+# SOURCE in the SAME persistent shell owning the already-started task emulator.
+# Uses ordinary adb only. No adb root, firewall changes or user-device operations.
+_native_run_instrumentation() {
+ local testapk="${1:?test APK required}" out="${NATIVE_EMU_OUT:?open-emulator helper must run first}"
+ test "${NATIVE_EMU_SERIAL:-}" = emulator-5580 || { echo 'Only task emulator serial allowed'; return 2; }
+ test -f "$testapk" || return 2
+ sha256sum "$testapk" > "$out/test-apk.sha256"
+ adb -s "$NATIVE_EMU_SERIAL" install -r "$testapk" | tee "$out/install-test.txt"
+ grep -q '^Success' "$out/install-test.txt" || return 1
+ adb -s "$NATIVE_EMU_SERIAL" shell getprop > "$out/emulator-properties.txt"
+ adb -s "$NATIVE_EMU_SERIAL" shell wm size > "$out/display-default.txt"
+ adb -s "$NATIVE_EMU_SERIAL" shell wm density >> "$out/display-default.txt"
+ adb -s "$NATIVE_EMU_SERIAL" shell dumpsys connectivity > "$out/guest-connectivity-observed.txt"
+ adb -s "$NATIVE_EMU_SERIAL" shell am instrument -w -r -e timeout_msec 180000 io.github.ktclat.c001apk.nativeapp.test/androidx.test.runner.AndroidJUnitRunner 2>&1 | tee "$out/instrumentation-default.log"
+ adb -s "$NATIVE_EMU_SERIAL" pull /sdcard/Android/data/io.github.ktclat.c001apk.nativeapp/files/independent-emulator-qa "$out/default-evidence"
+ # Actual narrow display; do not emulate geometry by relabelling a portrait Canvas screenshot.
+ adb -s "$NATIVE_EMU_SERIAL" shell wm size 640x1200
+ adb -s "$NATIVE_EMU_SERIAL" shell wm density 320
+ adb -s "$NATIVE_EMU_SERIAL" shell wm size > "$out/display-narrow.txt"
